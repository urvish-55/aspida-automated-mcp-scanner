# ---- Application settings ----
# Copy to .env and adjust. Never commit the real .env.
# All values have safe defaults; the scanner runs fully with no LLM and no API keys.

# SQLite by default; PostgreSQL-ready design (use e.g. postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./data/db/mcpentest.db

# Debug logging (structured JSON either way)
DEBUG=false

# ---- Scan safety (SAFE BY DEFAULT) ----
SAFE_MODE=true
# Overall scan timeout (seconds)
SCAN_TIMEOUT=300
# Per-probe timeout (seconds)
PER_TEST_TIMEOUT=10
# Maximum bytes per probe payload
MAX_PAYLOAD_SIZE=65536
# Maximum dynamic probe requests per scan
MAX_REQUESTS=100
# Dynamic probe rate limit (requests per second)
DYNAMIC_RATE_LIMIT=5
# Maximum uploaded config size (bytes)
MAX_UPLOAD_SIZE=1048576
# Maximum tools analyzed per scan
MAX_TOOLS_PER_SCAN=500

# ---- Network egress (SSRF protection) ----
# Allow dynamic scans of localhost/private addresses. Keep FALSE in production.
# Set true only to scan the bundled local test fixtures.
ALLOW_LOCAL_TARGETS=false
# Optional extra CIDRs allowed as dynamic targets (e.g. a lab subnet)
ALLOWED_TARGET_CIDRS=

# ---- Optional semantic layer (LLM) ----
# disabled | local | external
LLM_PROVIDER=disabled
# local (Ollama, OpenAI-compatible endpoint): http://127.0.0.1:11434/v1/chat/completions
LLM_ENDPOINT=
# model name for the provider (e.g. llama3.2)
LLM_MODEL=
# ONLY for external providers. Never committed, never logged.
LLM_API_KEY=
LLM_TIMEOUT=20

# ---- ML (advisory only) ----
ML_ENABLED=true
ML_MODEL_DIR=./ml/artifacts

# ---- API ----
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# ---- API authentication (ON by default) ----
# AUTH_REQUIRED=false disables it (local experiments only). If API_KEY is empty, a random key is
# generated on first start and stored in data/api_key (read it from there; it is never logged).
AUTH_REQUIRED=true
API_KEY=
AUTH_MAX_FAILURES_PER_MINUTE=10
